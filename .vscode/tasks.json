{
  "version": "2.0.0",
  "tasks": [
	{
		"label": "📡Webserver (via python interpreter)",
		"type": "shell",
		"command": "${command:python.interpreterPath}",
		"args": [
			"-m",
			"http.server",
			"8000"
		],
		"group": {
			"kind": "test",
			"isDefault": true
		},
		"options": {
			"cwd": "${workspaceFolder}/data/web"
		},
		"presentation": {
			"reveal": "always",
			"panel": "shared"
		},
		"problemMatcher": []
	},
	{
		"label": "📡TCP Monitor",
		"type": "shell",
		"command": "${command:python.interpreterPath}",
		"args": [
			"${workspaceFolder}/scripts/tcp_monitor.py"
		],
		"group": {
			"kind": "test",
			"isDefault": true
		},
		"presentation": {
			"echo": true,
			"reveal": "always",
			"focus": true,
			"panel": "dedicated",
			"showReuseMessage": false,
			"clear": true
		},
		"options": {
			"env": {
				"PATH": "${env:USERPROFILE}\\.platformio\\penv\\Scripts;${env:PATH}"
			}
		},
		"problemMatcher": []
	}
]
}
